{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rulesHash",
    "revision",
    "proposalHash",
    "acknowledged",
    "summary",
    "analysis",
    "objections",
    "replies",
    "close",
    "proposal",
    "stance",
    "question",
    "directiveHash",
    "signals"
  ],
  "properties": {
    "rulesHash": {
      "type": "string"
    },
    "revision": {
      "type": "integer"
    },
    "proposalHash": {
      "type": "string"
    },
    "acknowledged": {
      "type": "boolean"
    },
    "summary": {
      "type": "string"
    },
    "analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "position",
          "evidence",
          "alternative"
        ],
        "properties": {
          "topic": {
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "alternative": {
            "type": "string"
          }
        }
      }
    },
    "objections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "reason",
          "change",
          "evidence"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "change": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "replies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objectionId",
          "response"
        ],
        "properties": {
          "objectionId": {
            "type": "string"
          },
          "response": {
            "type": "string"
          }
        }
      }
    },
    "close": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objectionId",
          "reason"
        ],
        "properties": {
          "objectionId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "proposal": {
      "type": "string"
    },
    "stance": {
      "type": "string",
      "enum": [
        "agree",
        "disagree",
        "undecided"
      ]
    },
    "question": {
      "type": "string"
    },
    "directiveHash": {
      "type": "string"
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "topic",
          "detail",
          "impact",
          "blocking",
          "humanOnly",
          "position",
          "options",
          "objectionIds"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "gap",
              "disagreement"
            ]
          },
          "topic": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "impact": {
            "type": "integer"
          },
          "blocking": {
            "type": "boolean"
          },
          "humanOnly": {
            "type": "boolean"
          },
          "position": {
            "type": "string",
            "enum": [
              "support",
              "oppose",
              "unknown"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "objectionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
