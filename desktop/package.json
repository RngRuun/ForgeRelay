{
  "name": "forgerelay-desktop",
  "version": "0.6.3",
  "description": "ForgeRelay 本地智能体协作桌面应用",
  "author": "ForgeRelay",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.forgerelay.desktop",
    "productName": "ForgeRelay",
    "directories": {
      "output": "../../ForgeRelay-App"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "policy.cjs",
      "credentials.cjs",
      "bootstrap.html",
      "bootstrap.css",
      "bootstrap.js",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "engine",
        "filter": [
          "package.json",
          "*.mjs",
          "*.cjs",
          "*.md",
          "*.schema.json",
          "*.ps1",
          "*.py",
          "skills/**/*",
          "public/**/*",
          "!launch-window.mjs",
          "!desktop/**",
          "!data/**",
          "!outputs/**",
          "!test/**",
          "!node_modules/**"
        ]
      },
      {
        "from": "../node_modules/undici",
        "to": "engine/node_modules/undici",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "node.exe",
          "NODE-LICENSE.txt"
        ]
      }
    ],
    "win": {
      "icon": "assets/forgerelay.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false
    },
    "portable": {
      "artifactName": "ForgeRelay-${version}-Windows-x64.exe",
      "requestExecutionLevel": "user"
    },
    "compression": "normal"
  }
}
